{
  "name": "westeros-chronicles",
  "version": "0.2.1",
  "description": "A locally hosted, AI-simulated A Song of Ice and Fire grand strategy game powered by a local LLM.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --watch-path=server --watch-path=public/js/engine --watch-path=public/js/shared --watch-path=public/data server/index.js",
    "check": "node scripts/check-data.js && node --experimental-vm-modules --no-warnings scripts/check-syntax.mjs && node scripts/lint-engine.js",
    "fetch-sigils": "node scripts/fetch-sigils.js",
    "fetch-voices": "node scripts/fetch-voices.js",
    "test": "node --test tests/*.test.js",
    "soak": "node scripts/soak.js",
    "bench": "node scripts/bench.js",
    "playtest": "node scripts/playtest.js",
    "fetch-music": "node scripts/fetch-music.js",
    "serve": "node server/index.js",
    "check:syntax": "node --experimental-vm-modules --no-warnings scripts/check-syntax.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
